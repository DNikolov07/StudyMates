@model StudyGroupViewModel

@{
    ViewData["Title"] = Model.Title;
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-warning">@TempData["Error"]</div>
}

<h1>@Model.Title</h1>
<span class="badge bg-primary mb-3">@Model.SubjectName</span>

<p>@Model.Description</p>

<dl class="row">
    <dt class="col-sm-3">Created by</dt>
    <dd class="col-sm-9">@Model.CreatorName</dd>

    <dt class="col-sm-3">Members</dt>
    <dd class="col-sm-9">@Model.MembersCount / @Model.MaxMembers</dd>

    <dt class="col-sm-3">Created on</dt>
    <dd class="col-sm-9">@Model.CreatedOn.ToString("dd.MM.yyyy")</dd>
</dl>

<a asp-action="Index" class="btn btn-secondary">Back to all groups</a>

<a asp-controller="Session" asp-action="Index" asp-route-groupId="@Model.Id" class="btn btn-info">Sessions</a>

@if (User.Identity?.IsAuthenticated == true && !Model.IsCreator)
{
    if (Model.IsMember)
    {
        <form asp-action="Leave" asp-route-id="@Model.Id" method="post" class="d-inline">
            <button type="submit" class="btn btn-outline-danger">Leave group</button>
        </form>
    }
    else if (Model.MembersCount < Model.MaxMembers)
    {
        <form asp-action="Join" asp-route-id="@Model.Id" method="post" class="d-inline">
            <button type="submit" class="btn btn-success">Join group</button>
        </form>
    }
    else
    {
        <span class="badge bg-secondary">This group is full</span>
    }
}

@if (Model.IsCreator)
{
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Delete</a>
}