@{
    ViewData["Title"] = "Home Page";
}

<section class="hero text-center mb-5">
    <h1 class="display-5 fw-bold">Learn better together</h1>
    <p class="lead mb-4">
        StudyMates helps students find study groups, join them and plan study sessions.
    </p>
    <a asp-controller="StudyGroup" asp-action="Index" class="btn btn-light btn-lg me-2">Browse groups</a>
    <a asp-controller="StudyGroup" asp-action="Create" class="btn btn-outline-light btn-lg">Create a group</a>
</section>

<div class="row text-center g-4">
    <div class="col-md-4">
        <div class="feature-icon mb-3">&#128270;</div>
        <h5>Find a group</h5>
        <p class="text-muted">Browse study groups by subject and see how many places are still free.</p>
    </div>
    <div class="col-md-4">
        <div class="feature-icon mb-3">&#129309;</div>
        <h5>Join with one click</h5>
        <p class="text-muted">Register, join the groups you like and leave them whenever you want.</p>
    </div>
    <div class="col-md-4">
        <div class="feature-icon mb-3">&#128197;</div>
        <h5>Plan sessions</h5>
        <p class="text-muted">Group creators add study sessions with a topic, date and place.</p>
    </div>
</div>
