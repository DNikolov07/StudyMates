@model StudySessionListViewModel

@{
    ViewData["Title"] = "Sessions";
}

<h1 class="mb-1">@ViewData["Title"]</h1>
<p class="text-muted mb-4">@Model.StudyGroupTitle</p>

@if (Model.IsCreator)
{
    <a asp-action="Create" asp-route-groupId="@Model.StudyGroupId"
       class="btn btn-primary mb-3">Add session</a>
}

@if (!Model.Sessions.Any())
{
    <p class="text-muted">No sessions are planned yet.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Date</th>
                <th>Topic</th>
                <th>Location</th>
                @if (Model.IsCreator)
                {
                    <th></th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (StudySessionViewModel session in Model.Sessions)
            {
                <tr>
                    <td>@session.StartsOn.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@session.Topic</td>
                    <td>@session.Location</td>
                    @if (Model.IsCreator)
                    {
                        <td>
                            <form asp-action="Delete" asp-route-id="@session.Id" method="post">
                                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                            </form>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
}

<a asp-controller="StudyGroup" asp-action="Details" asp-route-id="@Model.StudyGroupId" class="btn btn-secondary">Back to group</a>